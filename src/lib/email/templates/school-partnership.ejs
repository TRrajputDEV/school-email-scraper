<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%= subject %></title>
  <!--[if !mso]><!-->
  <style type="text/css">
    @media screen and (max-width:600px){
      .wrapper{width:100%!important;padding:16px!important;}
      .container{width:100%!important;max-width:100%!important;}
      .hero-title{font-size:22px!important;line-height:1.3!important;}
      .content-pad{padding:24px 18px!important;}
      .product-col{display:block!important;width:100%!important;}
      .btn{width:100%!important;text-align:center!important;}
    }
  </style>
  <!--<![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#f0f4f8;color:#1a2d42;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <!-- Preheader text -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;color:#f0f4f8;"><%= previewText %>&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f0f4f8;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <!-- Email card -->
        <table role="presentation" class="container" width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px;max-width:600px;border-radius:4px;overflow:hidden;border:1px solid #d6dfe8;">

          <!-- HEADER / BRAND -->
          <tr>
            <td style="background:#1a2d42;padding:22px 32px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td>
                    <p style="margin:0;font-size:10px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#7da3c4;">Publisher Outreach</p>
                    <p style="margin:4px 0 0;font-size:20px;font-weight:bold;color:#ffffff;"><%= fromName || 'Educational Publisher' %></p>
                  </td>
                  <td align="right" valign="middle">
                    <span style="display:inline-block;background:#2864a3;color:#fff;font-size:10px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:3px;">CBSE Resources</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- HERO -->
          <tr>
            <td style="background:#2864a3;padding:36px 32px 30px;">
              <p style="margin:0 0 10px;font-size:11px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#a8c6e0;">School Partnership</p>
              <h1 class="hero-title" style="margin:0 0 14px;font-size:28px;line-height:1.25;color:#ffffff;font-weight:bold;"><%= title %></h1>
              <p style="margin:0;font-size:16px;line-height:1.6;color:#cfe2f1;"><%= intro %></p>
            </td>
          </tr>

          <!-- MAIN CONTENT -->
          <tr>
            <td class="content-pad" style="background:#ffffff;padding:36px 32px;">
              <p style="margin:0 0 24px;font-size:15px;line-height:1.75;color:#4a5e71;white-space:pre-line;"><%= body %></p>

              <!-- Products section -->
              <% if (products && products.length) { %>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 28px;border-top:2px solid #1a2d42;">
                <tr>
                  <td style="padding:16px 0 8px;">
                    <p style="margin:0;font-size:10px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#7da3c4;">Featured Resources</p>
                  </td>
                </tr>
                <% products.forEach(function(product){ %>
                <tr>
                  <td style="padding:12px 0;border-bottom:1px solid #e8edf3;">
                    <strong style="display:block;font-size:15px;color:#1a2d42;"><%= product.name %></strong>
                    <% if (product.category) { %><span style="display:inline-block;margin-top:4px;font-size:10px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#2864a3;"><%= product.category %></span><% } %>
                    <% if (product.description) { %><span style="display:block;margin-top:5px;font-size:13px;line-height:1.55;color:#6b7f90;"><%= product.description %></span><% } %>
                  </td>
                </tr>
                <% }); %>
              </table>
              <% } %>

              <!-- CTA Button -->
              <% if (buttonText && buttonUrl) { %>
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="border-radius:4px;background:#2864a3;">
                    <a href="<%= buttonUrl %>" class="btn" style="display:inline-block;padding:14px 28px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;letter-spacing:0.3px;">
                      <%= buttonText %>
                    </a>
                  </td>
                </tr>
              </table>
              <% } %>

              <!-- Catalogue link -->
              <% if (catalogueUrl) { %>
              <p style="margin:20px 0 0;font-size:13px;color:#6b7f90;">Browse the full catalogue: <a href="<%= catalogueUrl %>" style="color:#2864a3;font-weight:bold;text-decoration:none;">View Catalogue &rarr;</a></p>
              <% } %>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="background:#f0f4f8;padding:24px 32px;border-top:1px solid #d6dfe8;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td>
                    <p style="margin:0;font-size:12px;line-height:1.6;color:#6b7f90;">
                      <% if (fromName) { %>Sent by <strong style="color:#1a2d42;"><%= fromName %></strong><% if (fromEmail) { %> &lt;<a href="mailto:<%= fromEmail %>" style="color:#2864a3;text-decoration:none;"><%= fromEmail %></a>&gt;<% } %><br><% } %>
                      You are receiving this message as part of educational publisher outreach.
                    </p>
                    <p style="margin:10px 0 0;font-size:11px;color:#9aaab7;">
                      <a href="*|UNSUB|*" style="color:#9aaab7;text-decoration:underline;">Unsubscribe</a>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- /Email card -->

      </td>
    </tr>
  </table>
</body>
</html>
