<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%= subject %></title>

  <!--[if !mso]><!-->
  <style type="text/css">
    @media screen and (max-width: 600px) {
      .container {
        width: 100% !important;
      }

      .outer-pad {
        padding: 12px !important;
      }

      .content {
        padding: 26px 20px !important;
      }

      .hero {
        padding: 34px 22px !important;
      }

      .hero-title {
        font-size: 25px !important;
      }

      .product-inner {
        padding: 16px !important;
      }

      .mobile-full {
        display: block !important;
        width: 100% !important;
      }

      .mobile-center {
        text-align: center !important;
      }
    }
  </style>
  <!--<![endif]-->
</head>

<body
  style="margin:0;padding:0;background:#f3f6f8;color:#172b3f;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

  <!-- PREHEADER -->
  <div
    style="display:none!important;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f3f6f8;">
    <%= previewText %>&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
  </div>

  <table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
    border="0"
    style="width:100%;background:#f3f6f8;">

    <tr>
      <td
        align="center"
        class="outer-pad"
        style="padding:28px 12px;">

        <!-- EMAIL CONTAINER -->
        <table
          role="presentation"
          class="container"
          width="640"
          cellspacing="0"
          cellpadding="0"
          border="0"
          style="width:640px;max-width:640px;background:#ffffff;border:1px solid #dde4ea;border-radius:14px;overflow:hidden;">

          <!-- ================================= -->
          <!-- HEADER -->
          <!-- ================================= -->
          <tr>
            <td
              style="background:#152c43;padding:24px 30px;">

              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0">

                <tr>

                  <td
                    class="mobile-full mobile-center"
                    valign="middle"
                    style="vertical-align:middle;">

                    <% if (logoUrl) { %>
                      <img
                        src="<%= logoUrl %>"
                        alt="<%= fromName || 'Educational Publisher' %>"
                        width="120"
                        style="display:block;width:120px;max-width:120px;height:auto;border:0;outline:none;text-decoration:none;margin:0 0 10px;">
                    <% } %>

                    <p
                      style="margin:0;font-size:9px;line-height:1.4;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#93aec3;">
                      Educational Publishing
                    </p>

                    <p
                      style="margin:5px 0 0;font-size:21px;line-height:1.25;font-weight:bold;color:#ffffff;">
                      <%= fromName || "Educational Publisher" %>
                    </p>

                  </td>

                  <% if (badgeText) { %>
                  <td
                    align="right"
                    valign="middle"
                    class="mobile-full mobile-center"
                    style="vertical-align:middle;padding-top:8px;">

                    <span
                      style="display:inline-block;padding:8px 12px;background:#e57f32;color:#ffffff;border-radius:999px;font-size:9px;line-height:1;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">
                      <%= badgeText %>
                    </span>

                  </td>
                  <% } %>

                </tr>
              </table>

            </td>
          </tr>

          <!-- ================================= -->
          <!-- HERO -->
          <!-- ================================= -->
          <tr>
            <td
              class="hero"
              style="background:#2864a3;padding:42px 34px 38px;">

              <p
                style="margin:0 0 10px;font-size:10px;line-height:1.4;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#b9d3e9;">
                For Schools &amp; Educators
              </p>

              <h1
                class="hero-title"
                style="margin:0 0 14px;font-size:31px;line-height:1.2;font-weight:bold;color:#ffffff;">
                <%= title %>
              </h1>

              <p
                style="margin:0;font-size:16px;line-height:1.65;color:#e1edf6;">
                <%= intro %>
              </p>

            </td>
          </tr>

          <!-- ================================= -->
          <!-- INTRO -->
          <!-- ================================= -->
          <tr>
            <td
              class="content"
              style="background:#ffffff;padding:34px 34px 16px;">

              <% if (recipientName) { %>
                <p
                  style="margin:0 0 18px;font-size:14px;line-height:1.7;color:#172b3f;">
                  Dear <strong><%= recipientName %></strong>,
                </p>
              <% } %>

              <% if (schoolName) { %>
                <p
                  style="margin:0 0 18px;font-size:14px;line-height:1.7;color:#526579;">
                  <strong style="color:#172b3f;"><%= schoolName %></strong>
                </p>
              <% } %>

              <p
                style="margin:0;font-size:15px;line-height:1.8;color:#53677a;white-space:pre-line;">
                <%= body %>
              </p>

            </td>
          </tr>

          <!-- ================================= -->
          <!-- CATALOGUE SECTION -->
          <!-- ================================= -->
          <% if (products && products.length) { %>

          <tr>
            <td
              class="content"
              style="background:#ffffff;padding:12px 34px 8px;">

              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0">

                <tr>
                  <td
                    style="padding:0 0 12px;border-bottom:2px solid #e7edf2;">

                    <p
                      style="margin:0;font-size:10px;line-height:1.4;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#2864a3;">
                      Featured Catalogue
                    </p>

                    <p
                      style="margin:6px 0 0;font-size:13px;line-height:1.55;color:#7a8a99;">
                      A selection of educational resources from our catalogue.
                    </p>

                  </td>
                </tr>

              </table>

            </td>
          </tr>

          <!-- PRODUCT ITEMS -->
          <tr>
            <td
              class="content"
              style="background:#ffffff;padding:10px 34px 8px;">

              <% products.forEach(function(product, index) { %>

              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0"
                style="<%= index < products.length - 1 ? 'margin-bottom:14px;' : 'margin-bottom:0;' %>">

                <tr>
                  <td
                    style="border:1px solid #e1e7ec;border-radius:10px;background:#fbfcfd;">

                    <table
                      role="presentation"
                      width="100%"
                      cellspacing="0"
                      cellpadding="0"
                      border="0">

                      <tr>

                        <!-- ACCENT STRIP -->
                        <td
                          width="5"
                          style="width:5px;background:#e57f32;border-radius:10px 0 0 10px;font-size:1px;line-height:1px;">
                          &nbsp;
                        </td>

                        <!-- PRODUCT -->
                        <td
                          class="product-inner"
                          style="padding:17px 18px;">

                          <% if (product.category) { %>
                            <p
                              style="margin:0 0 6px;font-size:9px;line-height:1.4;font-weight:bold;letter-spacing:1.4px;text-transform:uppercase;color:#e57f32;">
                              <%= product.category %>
                            </p>
                          <% } %>

                          <p
                            style="margin:0;font-size:16px;line-height:1.35;font-weight:bold;color:#172b3f;">
                            <%= product.name %>
                          </p>

                          <% if (product.description) { %>
                            <p
                              style="margin:7px 0 0;font-size:13px;line-height:1.65;color:#64778a;">
                              <%= product.description %>
                            </p>
                          <% } %>

                          <% if (product.pdfUrl) { %>
                            <p style="margin:10px 0 0;">
                              <a
                                href="<%= product.pdfUrl %>"
                                style="font-size:12px;line-height:1.4;font-weight:bold;color:#2864a3;text-decoration:none;">
                                View this title &rarr;
                              </a>
                            </p>
                          <% } %>

                        </td>

                      </tr>

                    </table>

                  </td>
                </tr>

              </table>

              <% }); %>

            </td>
          </tr>

          <% } %>

          <!-- ================================= -->
          <!-- CATALOGUE CTA -->
          <!-- ================================= -->
          <% if (catalogueUrl || catalogueDownloadUrl) { %>

          <tr>
            <td
              class="content"
              style="background:#ffffff;padding:20px 34px 30px;">

              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0"
                style="background:#f7fafc;border:1px solid #dfe7ee;border-radius:12px;">

                <tr>
                  <td
                    align="center"
                    style="padding:24px 20px;">

                    <p
                      style="margin:0 0 6px;font-size:17px;line-height:1.4;font-weight:bold;color:#172b3f;">
                      Explore the complete catalogue
                    </p>

                    <p
                      style="margin:0 0 17px;font-size:13px;line-height:1.6;color:#718293;">
                      Browse the complete range of books and educational resources.
                    </p>

                    <% if (catalogueUrl) { %>
                    <table
                      role="presentation"
                      cellspacing="0"
                      cellpadding="0"
                      border="0"
                      style="margin:0 auto 10px;">

                      <tr>
                        <td
                          style="background:#2864a3;border-radius:7px;">

                          <a
                            href="<%= catalogueUrl %>"
                            style="display:inline-block;padding:13px 23px;font-size:13px;line-height:1.2;font-weight:bold;color:#ffffff;text-decoration:none;">
                            View Full Catalogue
                          </a>

                        </td>
                      </tr>

                    </table>
                    <% } %>

                    <% if (catalogueDownloadUrl) { %>
                    <p
                      style="margin:7px 0 0;font-size:12px;line-height:1.5;color:#7a8895;">

                      <a
                        href="<%= catalogueDownloadUrl %>"
                        style="font-weight:bold;color:#e57f32;text-decoration:none;">
                        Download Catalogue
                      </a>

                    </p>
                    <% } %>

                  </td>
                </tr>

              </table>

            </td>
          </tr>

          <% } %>

          <!-- ================================= -->
          <!-- OPTIONAL CTA -->
          <!-- ================================= -->
          <% if (buttonText && buttonUrl) { %>

          <tr>
            <td
              style="background:#ffffff;padding:0 34px 32px;text-align:center;">

              <table
                role="presentation"
                cellspacing="0"
                cellpadding="0"
                border="0"
                align="center">

                <tr>
                  <td
                    style="border:1px solid #d5dee6;border-radius:7px;background:#ffffff;">

                    <a
                      href="<%= buttonUrl %>"
                      style="display:inline-block;padding:11px 22px;font-size:12px;line-height:1.2;font-weight:bold;color:#172b3f;text-decoration:none;">
                      <%= buttonText %>
                    </a>

                  </td>
                </tr>

              </table>

            </td>
          </tr>

          <% } %>

          <!-- ================================= -->
          <!-- FOOTER -->
          <!-- ================================= -->
          <tr>
            <td
              style="background:#f3f6f8;border-top:1px solid #e0e6eb;padding:24px 30px;">

              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0">

                <tr>
                  <td align="center">

                    <% if (fromName) { %>
                    <p
                      style="margin:0 0 5px;font-size:12px;line-height:1.6;color:#596d7f;">
                      <strong style="color:#172b3f;"><%= fromName %></strong>
                      <% if (fromEmail) { %>
                        &nbsp;&middot;&nbsp;
                        <a
                          href="mailto:<%= fromEmail %>"
                          style="color:#2864a3;text-decoration:none;">
                          <%= fromEmail %>
                        </a>
                      <% } %>
                    </p>
                    <% } %>

                    <% if (websiteUrl) { %>
                    <p
                      style="margin:0 0 8px;font-size:11px;line-height:1.5;">
                      <a
                        href="<%= websiteUrl %>"
                        style="color:#6d7f8e;text-decoration:none;">
                        Visit our website
                      </a>
                    </p>
                    <% } %>

                    <p
                      style="margin:0;font-size:10px;line-height:1.7;color:#8996a1;">
                      <%= footerText || "You are receiving this message as part of educational publisher outreach." %>
                    </p>

                    <p
                      style="margin:10px 0 0;font-size:10px;line-height:1.5;">
                      <a
                        href="*|UNSUB|*"
                        style="color:#8a959e;text-decoration:underline;">
                        Unsubscribe
                      </a>
                    </p>

                  </td>
                </tr>

              </table>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>